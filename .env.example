# Createch Architects — environment contract
# Copy to .env.local for development. .env.local is gitignored.
# In production these live in Vercel → Project → Settings → Environment Variables.

# Absolute site origin. Canonical URLs, OG tags, sitemap and JSON-LD all use it.
# NEXT_PUBLIC_* values are inlined at BUILD time — changing this needs a redeploy.
#
# A variable that EXISTS IN VERCEL WITH A BLANK VALUE is not the same as an unset
# one: it arrives as "", not undefined. lib/site-url.ts normalises that back to the
# canonical origin, so either set a real URL here or delete the variable outright.
NEXT_PUBLIC_SITE_URL=https://createch.co.ke

# --- Admin PIN gate (/admin) -------------------------------------------------
# Hobbies pattern: the PIN is typed in the browser, held in sessionStorage, and
# sent as the X-Admin-Key header. A successful login also sets an httpOnly cookie.
# Either variable works; set one strong value (or the same value in both).
# Do NOT hardcode a PIN in the repo. Fail-closed: if both are unset, /admin 503s.
ADMIN_PIN=
ADMIN_SECRET_KEY=

# --- Railway image + chrome API ----------------------------------------------
# Image BYTES never sit in Vercel /tmp or in chrome JSON. Uploads are multipart
# POST to this origin; chrome JSON only stores the IDs/URLs that come back.
#
#   POST   {CREATECH_API_URL}/api/admin/media/     multipart field "file"
#          header X-Admin-Key: {ARCH_ADMIN_SECRET}
#          response: { id, url, alt?, width?, height?, filename? }
#   GET    {CREATECH_API_URL}/api/admin/media/
#   DELETE {CREATECH_API_URL}/api/admin/media/{id}/
#   GET    {CREATECH_API_URL}/api/admin/chrome/
#   PUT    {CREATECH_API_URL}/api/admin/chrome/     JSON body (chrome document)
#
# ARCH_ADMIN_SECRET is the Railway key. It is NOT the site PIN and is never
# sent to the browser — Next.js proxies uploads server-side.
CREATECH_API_URL=
ARCH_ADMIN_SECRET=

# --- Chrome JSON persistence -------------------------------------------------
# Preferred: Vercel Blob (@vercel/blob). Connect a Blob store to the project
# (OIDC: BLOB_STORE_ID is injected) or set a read-write token for local/CI.
# Pathname written: createch/chrome.json (layout + image IDs/URLs only).
#
# If Blob is not configured, chrome GET/PUT falls back to Railway
# /api/admin/chrome/ using the vars above.
#
# Local `next dev` without either store writes data/chrome.json (gitignored).
# That file does not survive a Vercel deploy — never rely on /tmp.
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=          # injected when a Blob store is connected on Vercel

# --- Enquiry form (app/(site)/contact/actions.ts) ----------------------------
# Server-only; never exposed to the browser. Without RESEND_API_KEY the form
# does not silently fail — it tells the visitor to email directly instead.
#
# ENQUIRY_FROM_EMAIL / MAIL_FROM must be on a domain verified in Resend,
# or delivery is rejected.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=anvi@createch.co.ke
ENQUIRY_FROM_EMAIL=website@createch.co.ke
# Legacy aliases still read if the names above are unset:
# CONTACT_TO_EMAIL=
# MAIL_FROM=
