# Createch Architects — environment contract (Build prompt §5)
# Copy to .env.local and fill in. .env.local is gitignored.

# Sanity — filled by `npx sanity@latest init` (Phase 0 step 6)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_AUTH_TOKEN=            # import script only (scripts/import-content.mjs)
SANITY_REVALIDATE_SECRET=     # any random string; also set in the Sanity webhook

# Contact form (Phase 3) — degrades to mailto: if RESEND_API_KEY is absent
RESEND_API_KEY=
CONTACT_TO_EMAIL=anvi@createch.co.ke

# Deployment
NEXT_PUBLIC_SITE_URL=https://createch.co.ke
