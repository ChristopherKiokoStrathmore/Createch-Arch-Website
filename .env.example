# Createch Architects — environment contract
# Copy to .env.local for development. .env.local is gitignored.
# In production these live in Vercel → Project → Settings → Environment Variables.

# Absolute site origin. Canonical URLs, OG tags, sitemap and JSON-LD all use it.
# NEXT_PUBLIC_* values are inlined at BUILD time — changing this needs a redeploy.
#
# A variable that EXISTS IN VERCEL WITH A BLANK VALUE is not the same as an unset
# one: it arrives as "", not undefined. lib/site-url.ts normalises that back to the
# canonical origin, so either set a real URL here or delete the variable outright.
NEXT_PUBLIC_SITE_URL=https://createch.co.ke

# --- Enquiry form (app/contact/actions.ts) -----------------------------------
# Server-only; never exposed to the browser. Without RESEND_API_KEY the form
# does not silently fail — it tells the visitor to email directly instead.
#
# ENQUIRY_FROM_EMAIL / MAIL_FROM must be on a domain verified in Resend,
# or delivery is rejected.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=anvi@createch.co.ke
ENQUIRY_FROM_EMAIL=website@createch.co.ke
# Legacy aliases still read if the names above are unset:
# CONTACT_TO_EMAIL=
# MAIL_FROM=
